From f64a5905b43d151eead271b3b348f2faa84e0ce4 Mon Sep 17 00:00:00 2001
From: tyeth <tyethgundry@googlemail.com>
Date: Thu, 19 Nov 2026 21:17:03 +0000
Subject: [PATCH 1/6] tinyusb (interim copy): host: re-enumerate a device that
 STALLs SET_CONFIGURATION

Vendored copy of the matching commit on the tinyusb branch host-sleep-recheck, so this
branch builds and runs before the next TinyUSB sync. Drop it when src/ is synced from
TinyUSB with that change in.

process_enumeration() treats only FAILED/TIMEOUT as an enumeration error.
A STALLed SET_CONFIGURATION falls through to ENUM_CONFIG_DRIVER: "Device
configured", and the class drivers open against endpoints that do not
exist. Their setup requests then fail; with the MSC driver's config_abort()
the device ends up mounted with interfaces that never work, and nothing
retries it.

Seen on hardware with a CircuitPython Feather ESP32-S2 behind an RP2040
Pico-PIO-USB host: it STALLs SET_CONFIGURATION on roughly half of all
enumerations right after a bus reset or hot-plug, host awake. Measured on
the TinyUSB copy in Adafruit_TinyUSB_Arduino 3.8.0 (where the MSC setup
chain still asserted instead of aborting): an ordinary hot-plug mounted
1 time in 5 without this change, 5 in 5 with it. The retry (enum_retry,
then the root port retry) re-resets the port and the device configures.

Only the SET_CONFIGURATION result is affected; STALLs that are legitimate
during enumeration (string descriptors, class requests) keep their meaning.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/host/usbh.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/host/usbh.c b/src/host/usbh.c
index b0282fb..d355344 100644
--- a/src/host/usbh.c
+++ b/src/host/usbh.c
@@ -2004,6 +2004,17 @@ static void process_enumeration(tuh_xfer_t *xfer) {
   if (daddr > 0) {
     TU_ASSERT(dev != NULL,);
   }
+
+  // A device that STALLs SET_CONFIGURATION is not configured: its endpoints do not exist and every class driver would
+  // fail against it, leaving it half-mounted for good. Re-enumerate it (fresh port reset) instead of going on.
+  if (XFER_RESULT_STALLED == xfer->result && ENUM_CONFIG_DRIVER == state) {
+    TU_LOG_USBH("[%u] SET_CONFIGURATION STALLed\r\n", daddr);
+    if (!enum_retry()) {
+      enum_full_complete(false);
+    }
+    return;
+  }
+
   uint16_t langid = 0x0409; // default is English
   bool is_enum_failed = false;
 
-- 
2.55.0.windows.2


From 7ee903a5c0a9b47b6a78f30c9b03470a435256bb Mon Sep 17 00:00:00 2001
From: tyeth <tyethgundry@googlemail.com>
Date: Thu, 19 Nov 2026 21:17:03 +0000
Subject: [PATCH 2/6] tinyusb (interim copy): host: add tuh_rhport_recheck() to
 find a device replaced while the host slept

Vendored copy of the matching commit on the tinyusb branch host-sleep-recheck, so this
branch builds and runs before the next TinyUSB sync. Drop it when src/ is synced from
TinyUSB with that change in.

A system sleep that stops the host controller (no SOF, its interrupts not
serviced) cannot see a detach. A device unplugged and replugged, replaced
or power-cycled meanwhile is back at address 0 when the host wakes, while
the stack still holds the old one at its old address: every transfer
fails, nothing re-enumerates it, and only a physical replug with the host
awake recovers. On an RP2040 the arduino-pico LowPower library idles the
core that runs the Pico-PIO-USB host, whose 1 ms SOF timer is its only
detach detection; the same applies to any HCD whose controller is halted
or unclocked in sleep.

tuh_rhport_recheck(rhport) queues a check in the usbh task: the device
attached directly to the port is sent GET_DESCRIPTOR(Device). One that
answers with the same VID/PID is left alone (one control transfer, no
remount); otherwise an attach event is posted, so usbh removes the old
device, resets the port and enumerates whatever is there. A port with a
device attached but nothing enumerated (an attach whose retries ran out,
or one never seen) is enumerated again; an empty port is left alone. Devices behind a
hub are covered by the hub's own port status change.

Equivalent logic (the probe and hcd_event_device_attach() from the
application) was verified on a Feather RP2040 USB Host with a CircuitPython
Feather ESP32-S2 power-cycled during a 15 s light sleep: 15/15 swaps and
no-swaps told apart, 10/10 swaps remounted. This commit itself has only
been compiled (arm-none-eabi-gcc 14.3, -Wall -Wextra -Wconversion
-Wsign-conversion -Wshadow -Werror), not run on hardware.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/host/usbh.c | 60 +++++++++++++++++++++++++++++++++++++++++++++++++
 src/host/usbh.h | 11 +++++++++
 2 files changed, 71 insertions(+)

diff --git a/src/host/usbh.c b/src/host/usbh.c
index d355344..1b3fb8e 100644
--- a/src/host/usbh.c
+++ b/src/host/usbh.c
@@ -242,6 +242,8 @@ static usbh_data_t _usbh_data;
 typedef struct {
   TUH_EPBUF_TYPE_DEF(tusb_control_request_t, request);
   TUH_EPBUF_DEF(ctrl, CFG_TUH_ENUMERATION_BUFSIZE);
+  TUH_EPBUF_DEF(recheck, sizeof(tusb_desc_device_t)); // tuh_rhport_recheck(): kept apart from ctrl, which an
+                                                      // enumeration starting meanwhile may be using
 } usbh_epbuf_t;
 CFG_TUH_MEM_SECTION static usbh_epbuf_t _usbh_epbuf;
 
@@ -993,6 +995,64 @@ bool tuh_task_stop(void) {
   return true;
 }
 
+//--------------------------------------------------------------------+
+// Root port re-check (after a system sleep)
+//--------------------------------------------------------------------+
+static void recheck_root_complete(tuh_xfer_t *xfer) {
+  const uint8_t rhport = (uint8_t) xfer->user_data;
+  const usbh_device_t *dev = get_device(xfer->daddr);
+  const tusb_desc_device_t *desc = (const tusb_desc_device_t *) _usbh_epbuf.recheck;
+
+  if (dev == NULL || !dev->connected) {
+    return; // detached meanwhile: its removal is already handled
+  }
+  if (xfer->result == XFER_RESULT_SUCCESS && xfer->actual_len == sizeof(tusb_desc_device_t) &&
+      desc->idVendor == dev->desc_device.idVendor && desc->idProduct == dev->desc_device.idProduct) {
+    TU_LOG_USBH("[%u:%u] Re-check: same device\r\n", rhport, xfer->daddr);
+    return;
+  }
+  // No answer at its address (a new or reset device waits at address 0), or another device answered: what was
+  // mounted is gone. An attach event removes it, resets the port and enumerates what is there now.
+  TU_LOG_USBH("[%u:%u] Re-check: device gone or replaced, re-enumerating\r\n", rhport, xfer->daddr);
+  hcd_event_device_attach(rhport, false);
+}
+
+static void recheck_root_call(void *param) {
+  const uint8_t rhport = (uint8_t) (uintptr_t) param;
+  if (_usbh_data.enumerating_daddr != TUSB_INDEX_INVALID_8) {
+    return; // an enumeration is talking to the bus already
+  }
+  for (uint8_t daddr = 1; daddr <= TOTAL_DEVICES; daddr++) {
+    const usbh_device_t *dev = get_device(daddr);
+    if (dev->connected && dev->bus_info.rhport == rhport && dev->bus_info.hub_addr == 0) {
+      if (!tuh_descriptor_get_device(daddr, _usbh_epbuf.recheck, sizeof(tusb_desc_device_t), recheck_root_complete,
+                                     rhport)) {
+        hcd_event_device_attach(rhport, false);
+      }
+      return; // one device per root port; a hub reports what changed behind it through its own port status
+    }
+  }
+  // Nothing enumerated, yet something is attached: an attach that failed (its retries used up) or was never seen
+  // while the host slept. Enumerate it again; with the port empty this is a no-op.
+  if (hcd_port_connect_status(rhport)) {
+    TU_LOG_USBH("[%u] Re-check: unenumerated device on the port, enumerating\r\n", rhport);
+    hcd_event_device_attach(rhport, false);
+  }
+}
+
+bool tuh_rhport_recheck(uint8_t rhport) {
+  TU_VERIFY(tuh_rhport_is_active(rhport));
+  // Queued for the usbh task like tuh_task_stop(): the check sends a control transfer and may post an attach
+  hcd_event_t event = { 0 };
+  event.rhport          = rhport;
+  event.event_id        = USBH_EVENT_FUNC_CALL;
+  event.func_call.func  = recheck_root_call;
+  event.func_call.param = (void *) (uintptr_t) rhport;
+  TU_VERIFY(osal_queue_send(_usbh_q, &event, false));
+  tuh_event_hook_cb(event.rhport, event.event_id, false);
+  return true;
+}
+
 //--------------------------------------------------------------------+
 // Control transfer
 //--------------------------------------------------------------------+
diff --git a/src/host/usbh.h b/src/host/usbh.h
index 44a91a1..f2aadef 100644
--- a/src/host/usbh.h
+++ b/src/host/usbh.h
@@ -213,6 +213,17 @@ bool tuh_rhport_is_active(uint8_t rhport);
 // Assert/de-assert Bus Reset signal to roothub port. USB specs: it should last 10-50ms
 bool tuh_rhport_reset_bus(uint8_t rhport, bool active);
 
+// Check that the device attached directly to a roothub port is still the one that was enumerated. Meant for after a
+// system sleep that stopped the host controller (no SOF, interrupts not serviced): a device unplugged and replugged,
+// replaced or power-cycled meanwhile leaves no detach behind, so the stack keeps talking to an address nothing answers.
+// The device is sent GET_DESCRIPTOR(Device); if it does not answer, or another VID/PID does, it is removed and the
+// port enumerated again (tuh_umount_cb() then tuh_mount_cb()). An unchanged device sees one control transfer. A port
+// with a device attached but nothing enumerated (an attach that failed, or was missed) is enumerated again.
+// Devices behind a hub are covered by the hub's own port status. The check runs in the usbh task; this only queues
+// it, so call it from task context (not an ISR) on the core that runs tuh_task(). Returns false if rhport is not an
+// active host port or the queue is full.
+bool tuh_rhport_recheck(uint8_t rhport);
+
 //--------------------------------------------------------------------+
 // Device API
 //--------------------------------------------------------------------+
-- 
2.55.0.windows.2


From d9d0b8b1e2af4c9b5c93169b4d056539a60cb61e Mon Sep 17 00:00:00 2001
From: tyeth <tyethgundry@googlemail.com>
Date: Thu, 19 Nov 2026 21:17:04 +0000
Subject: [PATCH 3/6] tinyusb (interim copy): host: wait
 CFG_TUH_ENUM_RETRY_DELAY_MS before re-enumerating a device that failed

Vendored copy of the matching commit on the tinyusb branch host-sleep-recheck, so this
branch builds and runs before the next TinyUSB sync. Drop it when src/ is synced from
TinyUSB with that change in.

enum_retry() and the root port retry of a failed attach both reset the
device again after the 150 ms attach debounce. A device that fails right
after a reset tends to fail again if reset straight away: a CircuitPython
Feather ESP32-S2 that STALLed SET_CONFIGURATION did so eight times in a
row, using CFG_TUH_ENUM_ATTEMPT_MAX x (1 + USBH_ENUM_ROOT_RETRY_MAX)
attempts within about two seconds, and was left attached but unmounted.

Wait CFG_TUH_ENUM_RETRY_DELAY_MS (default 1000 ms, configurable) before
those retries instead. A first attach still uses the 150 ms debounce.

Measured on the TinyUSB copy in Adafruit_TinyUSB_Arduino 3.8.0 with the
SET_CONFIGURATION retry: 12 swaps of that device during a sleep each, 11
mounted at the first re-detection with the 1 s delay (10 without), and
none ended unmounted.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/host/usbh.c   | 8 ++++++--
 src/tusb_option.h | 7 +++++++
 2 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/src/host/usbh.c b/src/host/usbh.c
index 1b3fb8e..c25d0db 100644
--- a/src/host/usbh.c
+++ b/src/host/usbh.c
@@ -2045,7 +2045,11 @@ static void enum_new_device(hcd_event_t *event) {
   dev0_bus->hub_addr       = event->connection.hub_addr;
   dev0_bus->hub_port       = event->connection.hub_port;
   _usbh_data.enum_attempt  = 0;
-  usbh_defer_func_ms_async(ENUM_DEBOUNCING_DELAY_MS, enum_delay_async, ENUM_AFTER_DEBOUNCING_DELAY);
+  // a root port retry of a failed attach: give the device time to settle before resetting it again
+  const bool root_retry = (_usbh_data.root_retry_count > 0) && (_usbh_data.root_retry_rhport == dev0_bus->rhport) &&
+                          (dev0_bus->hub_addr == 0);
+  usbh_defer_func_ms_async(root_retry ? CFG_TUH_ENUM_RETRY_DELAY_MS : ENUM_DEBOUNCING_DELAY_MS, enum_delay_async,
+                           ENUM_AFTER_DEBOUNCING_DELAY);
 }
 
 // process device enumeration
@@ -2570,7 +2574,7 @@ static bool enum_retry(void) {
   _usbh_data.enum_attempt++;
   TU_LOG_USBH("Enumeration failed, retry attempt %u/%u\r\n", _usbh_data.enum_attempt + 1, CFG_TUH_ENUM_ATTEMPT_MAX);
   _usbh_data.enumerating_daddr = 0;
-  usbh_defer_func_ms_async(ENUM_DEBOUNCING_DELAY_MS, enum_delay_async, ENUM_AFTER_DEBOUNCING_DELAY);
+  usbh_defer_func_ms_async(CFG_TUH_ENUM_RETRY_DELAY_MS, enum_delay_async, ENUM_AFTER_DEBOUNCING_DELAY);
   return true;
 #else
   return false;
diff --git a/src/tusb_option.h b/src/tusb_option.h
index 732c25b..e333693 100644
--- a/src/tusb_option.h
+++ b/src/tusb_option.h
@@ -803,6 +803,13 @@
     #define CFG_TUH_ENUM_ATTEMPT_MAX 2
   #endif
 
+  // Wait before resetting a device again after a failed enumeration (the retry above, and the root port retry of a
+  // failed attach), instead of the 150 ms attach debounce: a device that fails right after a reset tends to fail
+  // again if reset straight away, and back-to-back retries can use the whole budget within that window.
+  #ifndef CFG_TUH_ENUM_RETRY_DELAY_MS
+    #define CFG_TUH_ENUM_RETRY_DELAY_MS 1000
+  #endif
+
 #endif // CFG_TUH_ENABLED
 
 // Attribute to place data in accessible RAM for host controller (default: CFG_TUSB_MEM_SECTION)
-- 
2.55.0.windows.2


From 6f1f279be29e3fee5f8bd02e54c224931c4c19db Mon Sep 17 00:00:00 2001
From: tyeth <tyethgundry@googlemail.com>
Date: Thu, 19 Nov 2026 20:56:50 +0000
Subject: [PATCH 4/6] USBH MSC block device: time out a command that never
 completes, honour CSW status

wait_for_io() only gave up when the device unmounted. A device that stops
answering without a detach the host can see (one swapped or power-cycled
while the host was asleep, see tuh_rhport_recheck()) left the SdFat call
spinning forever. Give up after ADAFRUIT_USBH_MSC_IO_TIMEOUT_MS (3000 ms,
overridable).

_io_complete_cb() assumed every command succeeded ("TODO skip csw
status"), so a failed READ/WRITE was reported to SdFat as good data.
Return the CSW status from wait_for_io() instead.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/arduino/msc/Adafruit_USBH_MSC.cpp | 12 ++++++++++--
 src/arduino/msc/Adafruit_USBH_MSC.h   |  7 +++++++
 2 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/src/arduino/msc/Adafruit_USBH_MSC.cpp b/src/arduino/msc/Adafruit_USBH_MSC.cpp
index e004274..37388c7 100644
--- a/src/arduino/msc/Adafruit_USBH_MSC.cpp
+++ b/src/arduino/msc/Adafruit_USBH_MSC.cpp
@@ -39,6 +39,7 @@
 Adafruit_USBH_MSC_BlockDevice::Adafruit_USBH_MSC_BlockDevice() {
   _daddr = _lun = 0;
   _busy = false;
+  _io_ok = false;
   _wr_cb = NULL;
 }
 
@@ -65,6 +66,7 @@ bool Adafruit_USBH_MSC_BlockDevice::mounted(void) {
 bool Adafruit_USBH_MSC_BlockDevice::isBusy(void) { return _busy; }
 
 bool Adafruit_USBH_MSC_BlockDevice::wait_for_io(void) {
+  uint32_t const start_ms = tusb_time_millis_api();
   while (_busy) {
     // Removal closes the MSC interface without completing the pending command.
     // Release the synchronous caller instead of waiting for a missing callback.
@@ -72,12 +74,18 @@ bool Adafruit_USBH_MSC_BlockDevice::wait_for_io(void) {
       _busy = false;
       return false;
     }
+    // A device that stops answering without a detach the host can see (e.g.
+    // swapped while the host was asleep) may never complete the command
+    if (tusb_time_millis_api() - start_ms >= ADAFRUIT_USBH_MSC_IO_TIMEOUT_MS) {
+      _busy = false;
+      return false;
+    }
     if (tuh_task_event_ready()) {
       tuh_task();
     }
   }
 
-  return true;
+  return _io_ok;
 }
 
 bool Adafruit_USBH_MSC_BlockDevice::_io_complete_cb(
@@ -88,7 +96,7 @@ bool Adafruit_USBH_MSC_BlockDevice::_io_complete_cb(
     return false;
   }
 
-  // TODO skip csw status: assuming io is successful
+  _io_ok = (cb_data->csw->status == MSC_CSW_STATUS_PASSED);
   _busy = false;
 
   switch (cb_data->cbw->command[0]) {
diff --git a/src/arduino/msc/Adafruit_USBH_MSC.h b/src/arduino/msc/Adafruit_USBH_MSC.h
index d731495..3d50aeb 100644
--- a/src/arduino/msc/Adafruit_USBH_MSC.h
+++ b/src/arduino/msc/Adafruit_USBH_MSC.h
@@ -32,6 +32,12 @@
 
 #include "SdFat_Adafruit_Fork.h"
 
+// Longest a sector read/write waits for its SCSI command to complete before it
+// fails (e.g. a device that stopped answering without detaching)
+#ifndef ADAFRUIT_USBH_MSC_IO_TIMEOUT_MS
+#define ADAFRUIT_USBH_MSC_IO_TIMEOUT_MS 3000
+#endif
+
 class Adafruit_USBH_MSC_BlockDevice : public FsBlockDeviceInterface {
 public:
   Adafruit_USBH_MSC_BlockDevice();
@@ -66,6 +72,7 @@ private:
   // TODO use mutex to prevent race condition or atomic for better
   // implementation
   volatile bool _busy;
+  volatile bool _io_ok; // the last command's CSW reported success
 
   tuh_msc_complete_cb_t _wr_cb;
 
-- 
