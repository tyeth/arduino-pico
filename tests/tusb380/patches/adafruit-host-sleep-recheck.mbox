From 9c9f6710778052ff0acd21b0e3b71a35428dc07b Mon Sep 17 00:00:00 2001
From: tyeth <tyethgundry@googlemail.com>
Date: Thu, 19 Nov 2026 20:57:13 +0000
Subject: [PATCH 5/6] USBH: add Adafruit_USBH_Host::recheck() for after a sleep

Thin wrapper over tuh_rhport_recheck() on the port passed to begin(): call
it after waking from a sleep that stopped the host (arduino-pico LowPower
idles the core that runs a Pico-PIO-USB host) so that a device swapped or
power-cycled meanwhile is unmounted and enumerated again instead of being
addressed at a stale address forever.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/arduino/Adafruit_USBH_Host.cpp | 2 ++
 src/arduino/Adafruit_USBH_Host.h   | 8 ++++++++
 2 files changed, 10 insertions(+)

diff --git a/src/arduino/Adafruit_USBH_Host.cpp b/src/arduino/Adafruit_USBH_Host.cpp
index cdba773..4b4879d 100644
--- a/src/arduino/Adafruit_USBH_Host.cpp
+++ b/src/arduino/Adafruit_USBH_Host.cpp
@@ -148,6 +148,8 @@ void Adafruit_USBH_Host::task(uint32_t timeout_ms, bool in_isr) {
   tuh_task_ext(timeout_ms, in_isr);
 }
 
+bool Adafruit_USBH_Host::recheck(void) { return tuh_rhport_recheck(_rhport); }
+
 // Invoked when received report from device via interrupt endpoint
 TU_ATTR_WEAK void tuh_hid_report_received_cb(uint8_t dev_addr, uint8_t instance,
                                              uint8_t const *report,
diff --git a/src/arduino/Adafruit_USBH_Host.h b/src/arduino/Adafruit_USBH_Host.h
index 8daa8a7..75b2e26 100644
--- a/src/arduino/Adafruit_USBH_Host.h
+++ b/src/arduino/Adafruit_USBH_Host.h
@@ -90,6 +90,14 @@ public:
   bool begin(uint8_t rhport);
   void task(uint32_t timeout_ms = UINT32_MAX, bool in_isr = false);
 
+  // Call after waking from a sleep that stopped the host (e.g. LowPower
+  // sleepFor()/dormantFor() on RP2040, which idles the core running the host):
+  // a device unplugged, replaced or power-cycled meanwhile is detected and
+  // enumerated again (tuh_umount_cb() then tuh_mount_cb()); an unchanged one
+  // only sees one control transfer. Call it from the code that runs task(),
+  // i.e. loop1() when the host runs on core1. See tuh_rhport_recheck().
+  bool recheck(void);
+
   //------------- internal usage -------------//
   static Adafruit_USBH_Host *_instance;
 
-- 
2.55.0.windows.2


From 3fb307f28594ffdb224bbb0d471be87f1e5096d9 Mon Sep 17 00:00:00 2001
From: tyeth <tyethgundry@googlemail.com>
Date: Thu, 19 Nov 2026 20:58:09 +0000
Subject: [PATCH 6/6] examples: DualRole msc_file_explorer_sleep, a host that
 sleeps and rechecks its drive

RP2040 (arduino-pico LowPower, Pico-PIO-USB host on core1): lists the
drive, sleeps 10 s, then calls USBHost.recheck() from core1 so a drive
unplugged, swapped or power-cycled during the sleep is unmounted and the
new one mounted, while an unchanged drive stays mounted. Built for
pico_rp2040_tinyusb only (needs the LowPower library).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../.pico_rp2040_tinyusb.test.only            |   0
 .../msc_file_explorer_sleep.ino               | 126 ++++++++++++++++++
 .../msc_file_explorer_sleep/usbh_helper.h     |  99 ++++++++++++++
 3 files changed, 225 insertions(+)
 create mode 100644 examples/DualRole/MassStorage/msc_file_explorer_sleep/.pico_rp2040_tinyusb.test.only
 create mode 100644 examples/DualRole/MassStorage/msc_file_explorer_sleep/msc_file_explorer_sleep.ino
 create mode 100644 examples/DualRole/MassStorage/msc_file_explorer_sleep/usbh_helper.h

diff --git a/examples/DualRole/MassStorage/msc_file_explorer_sleep/.pico_rp2040_tinyusb.test.only b/examples/DualRole/MassStorage/msc_file_explorer_sleep/.pico_rp2040_tinyusb.test.only
new file mode 100644
index 0000000..e69de29
diff --git a/examples/DualRole/MassStorage/msc_file_explorer_sleep/msc_file_explorer_sleep.ino b/examples/DualRole/MassStorage/msc_file_explorer_sleep/msc_file_explorer_sleep.ino
new file mode 100644
index 0000000..995cf6c
--- /dev/null
+++ b/examples/DualRole/MassStorage/msc_file_explorer_sleep/msc_file_explorer_sleep.ino
@@ -0,0 +1,126 @@
+/*********************************************************************
+ Adafruit invests time and resources providing this open source code,
+ please support Adafruit and open-source hardware by purchasing
+ products from Adafruit!
+
+ MIT license, check LICENSE for more information
+ Copyright (c) 2026 for Adafruit Industries
+ All text above, and the splash screen below must be included in
+ any redistribution
+*********************************************************************/
+
+/* This example is a USB host that sleeps between uses of a USB drive, and
+ * keeps working when the drive is unplugged, swapped or power-cycled while it
+ * sleeps.
+ * - Device (Serial) runs on the native usb controller (roothub port0), core0
+ * - Host runs on 2 GPIOs with Pico-PIO-USB (roothub port1), core1
+ *
+ * While asleep, the LowPower library idles core1, so the host cannot see a
+ * drive being unplugged. After waking, USBHost.recheck() asks the device on the
+ * host port to identify itself: one that is gone or different is unmounted and
+ * the port enumerated again (tuh_msc_umount_cb() then tuh_msc_mount_cb()), an
+ * unchanged one is left mounted.
+ *
+ * Requirements:
+ * - RP2040, arduino-pico core with the LowPower library, USB Stack "Adafruit TinyUSB"
+ * - [Pico-PIO-USB](https://github.com/sekigon-gonnoc/Pico-PIO-USB) library
+ * - 2 consecutive GPIOs: D+ is defined by PIN_USB_HOST_DP, D- = D+ +1
+ * - Provide VBus (5v) and GND for peripheral
+ * - CPU Speed must be either 120 or 240 Mhz. Selected via "Menu -> CPU Speed"
+ */
+
+// SdFat is required for using Adafruit_USBH_MSC_SdFatDevice
+#include "SdFat_Adafruit_Fork.h"
+
+// USBHost is defined in usbh_helper.h
+#include "usbh_helper.h"
+
+#include <LowPower.h>
+
+// USB Host MSC Block Device object which implemented API for use with SdFat
+Adafruit_USBH_MSC_BlockDevice msc_block_dev;
+
+// file system object from SdFat
+FatVolume fatfs;
+
+// if file system is successfully mounted on usb block device
+volatile bool is_mounted = false;
+
+// set by core0 after waking, handled by core1 which runs the host stack
+volatile bool recheck_requested = false;
+
+void setup() {
+  Serial.begin(115200);
+  // while ( !Serial ) delay(10);   // wait for native usb
+  Serial.println("TinyUSB Host Mass Storage: sleep and recheck example");
+}
+
+void loop() {
+  if (is_mounted) {
+    fatfs.ls(&Serial, LS_SIZE);
+  } else {
+    Serial.println("No drive mounted");
+  }
+
+  Serial.println("Sleeping 10 s: unplug, swap or replug the drive now if you like");
+  Serial.flush();
+  LowPower.sleepFor(10000);
+  Serial.println("Awake");
+
+  // The host could not see the bus while asleep: have core1 check the drive
+  recheck_requested = true;
+
+  // Enumerating a new drive takes up to a second or so
+  delay(2000);
+}
+
+//------------- Core1 -------------//
+void setup1() {
+  // configure pio-usb: defined in usbh_helper.h
+  rp2040_configure_pio_usb();
+
+  // run host stack on controller (rhport) 1
+  USBHost.begin(1);
+}
+
+void loop1() {
+  // recheck() must be called from the code that runs USBHost.task()
+  if (recheck_requested) {
+    recheck_requested = false;
+    USBHost.recheck();
+  }
+  USBHost.task();
+}
+
+//--------------------------------------------------------------------+
+// TinyUSB Host callbacks
+//--------------------------------------------------------------------+
+extern "C"
+{
+
+// Invoked when a device with MassStorage interface is mounted
+void tuh_msc_mount_cb(uint8_t dev_addr) {
+  Serial.printf("Drive attached, address = %d\r\n", dev_addr);
+
+  // Initialize block device with MSC device address
+  msc_block_dev.begin(dev_addr);
+
+  // For simplicity this example only support LUN 0
+  msc_block_dev.setActiveLUN(0);
+
+  is_mounted = fatfs.begin(&msc_block_dev);
+}
+
+// Invoked when a device with MassStorage interface is unmounted
+void tuh_msc_umount_cb(uint8_t dev_addr) {
+  Serial.printf("Drive removed, address = %d\r\n", dev_addr);
+
+  // unmount file system
+  is_mounted = false;
+  fatfs.end();
+
+  // end block device
+  msc_block_dev.end();
+}
+
+}
