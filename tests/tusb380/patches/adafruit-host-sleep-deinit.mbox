From b800d4a0e8aece93b174147dd9eb9b34164774fb Mon Sep 17 00:00:00 2001
From: tyeth <tyethgundry@googlemail.com>
Date: Fri, 20 Nov 2026 01:21:52 +0000
Subject: [PATCH 2/6] USBH: add USBHost.end() to stop the host stack

end() calls tuh_deinit() for the port given to begin(). Every device is
removed first, with the usual unmount callbacks. begin() restarts the stack,
and attached devices are enumerated again.

This is for a sleep that stops the host, e.g. arduino-pico LowPower sleepFor()
on RP2040, which idles the core that runs the Pico-PIO-USB host: call end()
before the sleep and begin() after it. TinyUSB's maintainers recommend
tuh_deinit()/tuh_init() for this while the host stack has no suspend/resume.
The Pico-PIO-USB host controller driver needs hcd_deinit() for it.

begin() on ESP32 with MAX3421 now creates its interrupt task only once, so
begin() can be called again after end().

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/arduino/Adafruit_USBH_Host.cpp | 13 +++++++++----
 src/arduino/Adafruit_USBH_Host.h   | 10 ++++++++++
 2 files changed, 19 insertions(+), 4 deletions(-)

diff --git a/src/arduino/Adafruit_USBH_Host.cpp b/src/arduino/Adafruit_USBH_Host.cpp
index cdba773..6b1a88f 100644
--- a/src/arduino/Adafruit_USBH_Host.cpp
+++ b/src/arduino/Adafruit_USBH_Host.cpp
@@ -123,10 +123,13 @@ bool Adafruit_USBH_Host::begin(uint8_t rhport) {
   // ESP32 SPI assign pins when begin() of declaration as standard API
   _spi->begin(_sck, _miso, _mosi, -1);
 
-  // Create an task for executing interrupt handler in thread mode
-  max3421_intr_sem = xSemaphoreCreateBinary();
-  xTaskCreateUniversal(max3421_intr_task, "max3421 intr", 2048, NULL, 5, NULL,
-                       ARDUINO_RUNNING_CORE);
+  // Create an task for executing interrupt handler in thread mode.
+  // Only once: begin() is called again after end().
+  if (max3421_intr_sem == NULL) {
+    max3421_intr_sem = xSemaphoreCreateBinary();
+    xTaskCreateUniversal(max3421_intr_task, "max3421 intr", 2048, NULL, 5, NULL,
+                         ARDUINO_RUNNING_CORE);
+  }
 #else
   _spi->begin();
 #endif
@@ -148,6 +151,8 @@ void Adafruit_USBH_Host::task(uint32_t timeout_ms, bool in_isr) {
   tuh_task_ext(timeout_ms, in_isr);
 }
 
+bool Adafruit_USBH_Host::end(void) { return tuh_deinit(_rhport); }
+
 // Invoked when received report from device via interrupt endpoint
 TU_ATTR_WEAK void tuh_hid_report_received_cb(uint8_t dev_addr, uint8_t instance,
                                              uint8_t const *report,
diff --git a/src/arduino/Adafruit_USBH_Host.h b/src/arduino/Adafruit_USBH_Host.h
index 8daa8a7..99d2204 100644
--- a/src/arduino/Adafruit_USBH_Host.h
+++ b/src/arduino/Adafruit_USBH_Host.h
@@ -90,6 +90,16 @@ public:
   bool begin(uint8_t rhport);
   void task(uint32_t timeout_ms = UINT32_MAX, bool in_isr = false);
 
+  // Stop the host stack on the port given to begin() (tuh_deinit()). Every
+  // device is removed first: tuh_umount_cb() and the class unmount callbacks
+  // are invoked. Call begin() again to restart it; attached devices are then
+  // enumerated again. Use it around a sleep that stops the host, e.g. LowPower
+  // sleepFor() on RP2040, which idles the core that runs the Pico-PIO-USB host:
+  // call end() before the sleep and begin() after it, both from the code that
+  // runs task() (loop1() when the host runs on core1).
+  // Returns false if the host controller driver cannot be stopped.
+  bool end(void);
+
   //------------- internal usage -------------//
   static Adafruit_USBH_Host *_instance;
 
-- 
