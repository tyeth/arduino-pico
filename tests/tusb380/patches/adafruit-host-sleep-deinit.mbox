From 6c730aca03149de9da97c1e99a9d2b78292b7f8a Mon Sep 17 00:00:00 2001
From: tyeth <tyethgundry@googlemail.com>
Date: Fri, 20 Nov 2026 01:22:21 +0000
Subject: [PATCH 3/6] examples: DualRole msc_file_explorer_sleep, a USB host
 that sleeps

RP2040 with arduino-pico's LowPower library: core0 sleeps for 10 s at a time,
core1 runs the Pico-PIO-USB host. Before each sleep core1 stops the host
stack with USBHost.end() (the drive is unmounted); after it, USBHost.begin()
starts it again and the drive attached at that time is mounted, so a drive
unplugged, swapped or power-cycled during the sleep is handled. All drive
access is on core1. CI builds it for the Feather RP2040 USB Host only
(.feather_rp2040_tinyusb.test.only).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../.feather_rp2040_tinyusb.test.only         |   0
 .../msc_file_explorer_sleep.ino               | 159 ++++++++++++++++++
 .../msc_file_explorer_sleep/usbh_helper.h     |  99 +++++++++++
 3 files changed, 258 insertions(+)
 create mode 100644 examples/DualRole/MassStorage/msc_file_explorer_sleep/.feather_rp2040_tinyusb.test.only
 create mode 100644 examples/DualRole/MassStorage/msc_file_explorer_sleep/msc_file_explorer_sleep.ino
 create mode 100644 examples/DualRole/MassStorage/msc_file_explorer_sleep/usbh_helper.h

diff --git a/examples/DualRole/MassStorage/msc_file_explorer_sleep/.feather_rp2040_tinyusb.test.only b/examples/DualRole/MassStorage/msc_file_explorer_sleep/.feather_rp2040_tinyusb.test.only
new file mode 100644
index 0000000..e69de29
diff --git a/examples/DualRole/MassStorage/msc_file_explorer_sleep/msc_file_explorer_sleep.ino b/examples/DualRole/MassStorage/msc_file_explorer_sleep/msc_file_explorer_sleep.ino
new file mode 100644
index 0000000..07c7d42
--- /dev/null
+++ b/examples/DualRole/MassStorage/msc_file_explorer_sleep/msc_file_explorer_sleep.ino
@@ -0,0 +1,159 @@
+/*********************************************************************
+ Adafruit invests time and resources providing this open source code,
+ please support Adafruit and open-source hardware by purchasing
+ products from Adafruit!
+
+ MIT license, check LICENSE for more information
+ Copyright (c) 2026 for Adafruit Industries
+ All text above, and the splash screen below must be included in
+ any redistribution
+*********************************************************************/
+
+/* This example is a USB host that sleeps between uses of a USB drive, and
+ * keeps working when the drive is unplugged, swapped or power-cycled while it
+ * sleeps.
+ * - Device (Serial) runs on the native usb controller (roothub port0), core0
+ * - Host runs on 2 GPIOs with Pico-PIO-USB (roothub port1), core1
+ *
+ * While asleep, the LowPower library idles core1, so the host cannot see a
+ * drive being unplugged. So the host stack is stopped before the sleep
+ * (USBHost.end(): the drive is unmounted) and started again after it
+ * (USBHost.begin(): the drive that is attached now is enumerated and mounted).
+ *
+ * All drive access happens on core1, which runs the host stack: core0 only
+ * sleeps, and asks core1 to list the drive, to stop the host and to start it.
+ *
+ * Requirements:
+ * - RP2040, arduino-pico core with the LowPower library, USB Stack "Adafruit TinyUSB"
+ * - [Pico-PIO-USB](https://github.com/sekigon-gonnoc/Pico-PIO-USB) library
+ * - 2 consecutive GPIOs: D+ is defined by PIN_USB_HOST_DP, D- = D+ +1
+ * - Provide VBus (5v) and GND for peripheral
+ * - CPU Speed must be either 120 or 240 Mhz. Selected via "Menu -> CPU Speed"
+ */
+
+// SdFat is required for using Adafruit_USBH_MSC_SdFatDevice
+#include "SdFat_Adafruit_Fork.h"
+
+// USBHost is defined in usbh_helper.h
+#include "usbh_helper.h"
+
+#include <LowPower.h>
+
+// USB Host MSC Block Device object which implemented API for use with SdFat
+Adafruit_USBH_MSC_BlockDevice msc_block_dev;
+
+// file system object from SdFat
+FatVolume fatfs;
+
+// if file system is successfully mounted on usb block device
+volatile bool is_mounted = false;
+
+// core0 asks core1 to do one of these, then waits until core1 sets it to NONE
+enum { REQ_NONE, REQ_LIST, REQ_STOP, REQ_START };
+volatile int core1_request = REQ_NONE;
+
+static void ask_core1(int request) {
+  core1_request = request;
+  while (core1_request != REQ_NONE) {
+    delay(10);
+  }
+}
+
+void setup() {
+  Serial.begin(115200);
+  // while ( !Serial ) delay(10);   // wait for native usb
+  Serial.println("TinyUSB Host Mass Storage: sleep example");
+}
+
+void loop() {
+  // A drive takes about a second to enumerate and mount after begin()
+  for (uint32_t t0 = millis(); !is_mounted && millis() - t0 < 10000;) {
+    delay(10);
+  }
+  ask_core1(REQ_LIST);
+
+  // Stop the host stack: the drive is unmounted
+  ask_core1(REQ_STOP);
+
+  Serial.println("Sleeping 10 s: unplug, swap or replug the drive now if you like");
+  Serial.flush();
+  LowPower.sleepFor(10000);
+  Serial.println("Awake");
+
+  // Start the host stack again: the drive that is attached now is mounted
+  ask_core1(REQ_START);
+}
+
+//------------- Core1 -------------//
+static bool host_running = false;
+
+void setup1() {
+  // configure pio-usb: defined in usbh_helper.h
+  rp2040_configure_pio_usb();
+
+  // run host stack on controller (rhport) 1
+  host_running = USBHost.begin(1);
+}
+
+void loop1() {
+  if (host_running) {
+    USBHost.task();
+  }
+
+  switch (core1_request) {
+    case REQ_LIST:
+      if (is_mounted) {
+        fatfs.ls(&Serial, LS_SIZE);
+      } else {
+        Serial.println("No drive mounted");
+      }
+      break;
+
+    case REQ_STOP:
+      // end() unmounts the drive (tuh_msc_umount_cb() below)
+      USBHost.end();
+      host_running = false;
+      break;
+
+    case REQ_START:
+      host_running = USBHost.begin(1);
+      break;
+
+    default:
+      return;
+  }
+  core1_request = REQ_NONE;
+}
+
+//--------------------------------------------------------------------+
+// TinyUSB Host callbacks (core1)
+//--------------------------------------------------------------------+
+extern "C"
+{
+
+// Invoked when a device with MassStorage interface is mounted
+void tuh_msc_mount_cb(uint8_t dev_addr) {
+  Serial.printf("Drive attached, address = %d\r\n", dev_addr);
+
+  // Initialize block device with MSC device address
+  msc_block_dev.begin(dev_addr);
+
+  // For simplicity this example only support LUN 0
+  msc_block_dev.setActiveLUN(0);
+
+  is_mounted = fatfs.begin(&msc_block_dev);
+}
+
+// Invoked when a device with MassStorage interface is unmounted
+void tuh_msc_umount_cb(uint8_t dev_addr) {
+  Serial.printf("Drive removed, address = %d\r\n", dev_addr);
+
+  // unmount file system
+  is_mounted = false;
+  fatfs.end();
+
+  // end block device
+  msc_block_dev.end();
+}
+
+}
diff --git a/examples/DualRole/MassStorage/msc_file_explorer_sleep/usbh_helper.h b/examples/DualRole/MassStorage/msc_file_explorer_sleep/usbh_helper.h
new file mode 100644
index 0000000..29c1a6a
--- /dev/null
+++ b/examples/DualRole/MassStorage/msc_file_explorer_sleep/usbh_helper.h
@@ -0,0 +1,99 @@
+/*********************************************************************
+ Adafruit invests time and resources providing this open source code,
+ please support Adafruit and open-source hardware by purchasing
+ products from Adafruit!
+
+ MIT license, check LICENSE for more information
+ Copyright (c) 2019 Ha Thach for Adafruit Industries
+ All text above, and the splash screen below must be included in
+ any redistribution
+*********************************************************************/
+
+#ifndef USBH_HELPER_H
+#define USBH_HELPER_H
+
+#ifdef ARDUINO_ARCH_RP2040
+  // pio-usb is required for rp2040 host
+  #include "pio_usb.h"
+
+  // Pin D+ for host, D- = D+ + 1
+  #ifndef PIN_USB_HOST_DP
+  #define PIN_USB_HOST_DP  16
+  #endif
+
+  // Pin for enabling Host VBUS. comment out if not used
+  #ifndef PIN_5V_EN
+  #define PIN_5V_EN        18
+  #endif
+
+  #ifndef PIN_5V_EN_STATE
+  #define PIN_5V_EN_STATE  1
+  #endif
+#endif // ARDUINO_ARCH_RP2040
+
+#include "Adafruit_TinyUSB.h"
+
+#if defined(CFG_TUH_MAX3421) && CFG_TUH_MAX3421
+  // USB Host using MAX3421E: SPI, CS, INT
+  #include "SPI.h"
+
+  #if defined(ARDUINO_METRO_ESP32S2)
+    Adafruit_USBH_Host USBHost(&SPI, 15, 14);
+  #elif defined(ARDUINO_ADAFRUIT_FEATHER_ESP32_V2)
+    Adafruit_USBH_Host USBHost(&SPI, 33, 15);
+  #else
+    // Default CS and INT are pin 10, 9
+    Adafruit_USBH_Host USBHost(&SPI, 10, 9);
+  #endif
+#else
+  // Native USB Host such as rp2040
+  Adafruit_USBH_Host USBHost;
+#endif
+
+//--------------------------------------------------------------------+
+// Helper Functions
+//--------------------------------------------------------------------+
+
+#ifdef ARDUINO_ARCH_RP2040
+static void rp2040_configure_pio_usb(void) {
+  //while ( !Serial ) delay(10);   // wait for native usb
+  Serial.println("Core1 setup to run TinyUSB host with pio-usb");
+
+  // Check for CPU frequency, must be multiple of 12 Mhz for bit-banging USB
+  uint32_t cpu_hz = clock_get_hz(clk_sys);
+  if (cpu_hz % 12000000UL) {
+    while (!Serial) {
+      delay(10);   // wait for native usb
+    }
+    Serial.printf("Error: CPU Clock = %lu, PIO USB require CPU clock must be multiple of 12 Mhz\r\n", cpu_hz);
+    Serial.printf("Change your CPU Clock to 12*n Mhz in Menu->CPU Speed \r\n");
+    while (1) {
+      delay(1);
+    }
+  }
+
+#ifdef PIN_5V_EN
+  pinMode(PIN_5V_EN, OUTPUT);
+  digitalWrite(PIN_5V_EN, PIN_5V_EN_STATE);
+#endif
+
+  pio_usb_configuration_t pio_cfg = PIO_USB_DEFAULT_CONFIG;
+  pio_cfg.pin_dp = PIN_USB_HOST_DP;
+
+#if defined(ARDUINO_RASPBERRY_PI_PICO_W)
+  // For pico-w, PIO is also used to communicate with cyw43
+  // Therefore we need to alternate the pio-usb configuration
+  // details https://github.com/sekigon-gonnoc/Pico-PIO-USB/issues/46
+  pio_cfg.sm_tx      = 3;
+  pio_cfg.sm_rx      = 2;
+  pio_cfg.sm_eop     = 3;
+  pio_cfg.pio_rx_num = 0;
+  pio_cfg.pio_tx_num = 1;
+  pio_cfg.tx_ch      = 9;
+#endif
+
+  USBHost.configure_pio_usb(1, &pio_cfg);
+}
+#endif
+
+#endif
-- 
