From 967f9cf73860e4f264f43f8a178aceb9b3ff4b6d Mon Sep 17 00:00:00 2001
From: tyeth <tyethgundry@googlemail.com>
Date: Fri, 20 Nov 2026 01:21:33 +0000
Subject: [PATCH 1/6] USBH MSC block device: report a failed command to SdFat

_io_complete_cb() did not check the CSW status ("TODO skip csw status"), so
wait_for_io() returned true for a READ or WRITE that the device reported as
failed. It now returns false unless the CSW status is PASSED.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/arduino/msc/Adafruit_USBH_MSC.cpp | 5 +++--
 src/arduino/msc/Adafruit_USBH_MSC.h   | 1 +
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/src/arduino/msc/Adafruit_USBH_MSC.cpp b/src/arduino/msc/Adafruit_USBH_MSC.cpp
index e004274..0688c4c 100644
--- a/src/arduino/msc/Adafruit_USBH_MSC.cpp
+++ b/src/arduino/msc/Adafruit_USBH_MSC.cpp
@@ -39,6 +39,7 @@
 Adafruit_USBH_MSC_BlockDevice::Adafruit_USBH_MSC_BlockDevice() {
   _daddr = _lun = 0;
   _busy = false;
+  _io_ok = false;
   _wr_cb = NULL;
 }
 
@@ -77,7 +78,7 @@ bool Adafruit_USBH_MSC_BlockDevice::wait_for_io(void) {
     }
   }
 
-  return true;
+  return _io_ok;
 }
 
 bool Adafruit_USBH_MSC_BlockDevice::_io_complete_cb(
@@ -88,7 +89,7 @@ bool Adafruit_USBH_MSC_BlockDevice::_io_complete_cb(
     return false;
   }
 
-  // TODO skip csw status: assuming io is successful
+  _io_ok = (cb_data->csw->status == MSC_CSW_STATUS_PASSED);
   _busy = false;
 
   switch (cb_data->cbw->command[0]) {
diff --git a/src/arduino/msc/Adafruit_USBH_MSC.h b/src/arduino/msc/Adafruit_USBH_MSC.h
index d731495..cd82c48 100644
--- a/src/arduino/msc/Adafruit_USBH_MSC.h
+++ b/src/arduino/msc/Adafruit_USBH_MSC.h
@@ -66,6 +66,7 @@ private:
   // TODO use mutex to prevent race condition or atomic for better
   // implementation
   volatile bool _busy;
+  volatile bool _io_ok; // the last command's CSW reported success
 
   tuh_msc_complete_cb_t _wr_cb;
 
-- 
