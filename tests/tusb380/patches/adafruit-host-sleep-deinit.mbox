From bd5d56ca9194c668f610e93c69f32e7d235ecd30 Mon Sep 17 00:00:00 2001
From: tyeth <tyethgundry@googlemail.com>
Date: Fri, 20 Nov 2026 01:22:37 +0000
Subject: [PATCH 5/6] pio_usb: add hcd_deinit(), so tuh_deinit() and tuh_init()
 work

tuh_deinit() failed its TU_ASSERT(hcd_deinit()) with the Pico-PIO-USB host,
because hcd_pio_usb.c had no hcd_deinit(). An application that stops the host
around a sleep (the core that runs the host is idle, so it misses a detach)
could not restart it.

Pico-PIO-USB cannot be initialized twice: pio_usb_host_init() claims PIO
state machines and program space and starts the SOF timer. Its
pio_usb_host_stop()/pio_usb_host_restart() cannot be used: they wait for
flags that only the host stack removed from Pico-PIO-USB in 2024 cleared, so
they never return. So:
- hcd_deinit() parks every root port: no SOF and no transfers (suspended),
  a bus reset that is under way is ended (its hcd_port_reset_end() will not
  come, and the lines would stay in SE0), endpoints and pending interrupt
  status are cleared, and the IRQ handler drops events until the next
  hcd_init().
- hcd_init() calls pio_usb_host_init() only the first time. After
  hcd_deinit() it marks the ports as disconnected, so the next frame reports
  the device that is attached now as a new connection, and usbh enumerates
  it. Events are enabled before pio_usb_host_init(), so a connect in the
  first frame is not dropped.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../raspberrypi/pio_usb/hcd_pio_usb.c         | 83 ++++++++++++++++++-
 1 file changed, 81 insertions(+), 2 deletions(-)

diff --git a/src/portable/raspberrypi/pio_usb/hcd_pio_usb.c b/src/portable/raspberrypi/pio_usb/hcd_pio_usb.c
index 8a7722f..055b1c5 100644
--- a/src/portable/raspberrypi/pio_usb/hcd_pio_usb.c
+++ b/src/portable/raspberrypi/pio_usb/hcd_pio_usb.c
@@ -10,6 +10,7 @@
 #if CFG_TUH_ENABLED && (CFG_TUSB_MCU == OPT_MCU_RP2040) && CFG_TUH_RPI_PIO_USB
 
 #include "pico.h"
+#include "hardware/gpio.h"
 
 #include "pio_usb.h"
 
@@ -37,6 +38,43 @@
 
 static pio_usb_configuration_t pio_host_cfg = PIO_USB_DEFAULT_CONFIG;
 
+// Pico-PIO-USB cannot be initialized a second time: pio_usb_host_init() claims the PIO state machines and program
+// space, and starts the SOF timer. pio_usb_host_stop() and pio_usb_host_restart() cannot be used either: they wait for
+// a flag that only the old Pico-PIO-USB host stack cleared. So hcd_deinit() leaves the PIO and the SOF timer running
+// and only parks the root ports. The next hcd_init() makes them detect the attached devices again, as new devices.
+// Like the other HCD functions, hcd_deinit() must run on the core that called the first hcd_init(): the SOF timer
+// runs there, so a frame never runs in the middle of it.
+static bool pio_inited = false;           // pio_usb_host_init() is done
+static volatile bool hcd_running = false; // between hcd_init() and hcd_deinit()
+
+// Park a root port: no SOF and no transfers. A frame then skips the port, and does not check it for a detach either.
+// Its endpoints are freed and its pending interrupt status is cleared.
+static void root_port_park(uint8_t pio_rhport) {
+  root_port_t *root = PIO_USB_ROOT_PORT(pio_rhport);
+
+  root->suspended = true;
+
+  // End a bus reset that is under way: its hcd_port_reset_end() will not come, and the lines would stay in SE0.
+  // As pio_usb_host_port_reset_end(), without un-suspending the port.
+  gpio_set_oeover(root->pin_dp, GPIO_OVERRIDE_NORMAL);
+  gpio_set_oeover(root->pin_dm, GPIO_OVERRIDE_NORMAL);
+  gpio_set_outover(root->pin_dp, GPIO_OVERRIDE_NORMAL);
+  gpio_set_outover(root->pin_dm, GPIO_OVERRIDE_NORMAL);
+
+  for (uint8_t ep_idx = 0; ep_idx < PIO_USB_EP_POOL_CNT; ep_idx++) {
+    endpoint_t *ep = PIO_USB_ENDPOINT(ep_idx);
+    if (ep->root_idx == pio_rhport) {
+      ep->size         = 0; // size 0 marks a free endpoint
+      ep->has_transfer = false;
+    }
+  }
+
+  root->ep_complete = 0;
+  root->ep_stalled  = 0;
+  root->ep_error    = 0;
+  root->ints        = 0;
+}
+
 //--------------------------------------------------------------------+
 // HCD API
 //--------------------------------------------------------------------+
@@ -51,8 +89,40 @@ bool hcd_init(uint8_t rhport, const tusb_rhport_init_t* rh_init) {
   (void) rhport;
   (void) rh_init;
 
