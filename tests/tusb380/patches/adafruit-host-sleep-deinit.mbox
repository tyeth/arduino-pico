From ac7dad74bccb358d371bfadaddbc2d462203ed83 Mon Sep 17 00:00:00 2001
From: tyeth <tyethgundry@googlemail.com>
Date: Thu, 19 Nov 2026 22:49:37 +0000
Subject: [PATCH 4/6] tinyusb (interim copy of hathach/tinyusb#4582): host:
 re-enumerate a device that STALLs SET_CONFIGURATION

Vendored copy of hathach/tinyusb#4582, so this branch builds and runs before the
next TinyUSB sync. Drop it when src/ is synced from TinyUSB with that change in.

process_enumeration() treated only FAILED/TIMEOUT as enumeration errors; a STALLed
SET_CONFIGURATION went on as "Device configured" with the device unconfigured.
It now retries like the other errors.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/host/usbh.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/host/usbh.c b/src/host/usbh.c
index b0282fb..d355344 100644
--- a/src/host/usbh.c
+++ b/src/host/usbh.c
@@ -2004,6 +2004,17 @@ static void process_enumeration(tuh_xfer_t *xfer) {
   if (daddr > 0) {
     TU_ASSERT(dev != NULL,);
   }
+
+  // A device that STALLs SET_CONFIGURATION is not configured: its endpoints do not exist and every class driver would
+  // fail against it, leaving it half-mounted for good. Re-enumerate it (fresh port reset) instead of going on.
+  if (XFER_RESULT_STALLED == xfer->result && ENUM_CONFIG_DRIVER == state) {
+    TU_LOG_USBH("[%u] SET_CONFIGURATION STALLed\r\n", daddr);
+    if (!enum_retry()) {
+      enum_full_complete(false);
+    }
+    return;
+  }
+
   uint16_t langid = 0x0409; // default is English
   bool is_enum_failed = false;
 
-- 
